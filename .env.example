# ── Database & Redis ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ilecture_mfu?schema=public"
# Leave REDIS_URL empty to run without Redis (single instance, jobs run in-process)
REDIS_URL="redis://localhost:6379"   # if Redis is not running, the app falls back to in-process mode automatically

# ── NextAuth & Google OAuth (MFU Workspace) ─────────────────────
# Use your LAN IP (e.g. http://192.168.1.20:3000) so phones/iPads on the same Wi-Fi can join
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-strong-secret-key"   # openssl rand -base64 32
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Allowed Google Workspace domains
STAFF_EMAIL_DOMAIN="mfu.ac.th"
STUDENT_EMAIL_DOMAIN="lamduan.mfu.ac.th"
# Comma-separated staff emails that should get the ADVISOR role
ADVISOR_EMAILS=""
# Comma-separated emails that should get the ADMIN role
ADMIN_EMAILS=""

# ── Demo mode ───────────────────────────────────────────────────
# "true" adds a one-tap demo login (instructor + students) and mock Google Classroom.
# Set to "false" in production.
DEMO_MODE="true"

# ── AI Provider (OpenAI or Ollama-compatible) ───────────────────
# Leave OPENAI_API_KEY empty to use the built-in offline heuristics.
OPENAI_API_KEY=""
# For Ollama: OPENAI_BASE_URL="http://localhost:11434/v1"
OPENAI_BASE_URL=""
AI_MODEL_CHAT="gpt-4o-mini"
AI_MODEL_EMBEDDING="text-embedding-3-small"
# Cosine similarity at which a new question is merged into an existing one
CLUSTER_SIMILARITY_THRESHOLD="0.84"

# ── Storage for synced slide PDFs ───────────────────────────────
STORAGE_DIR="./storage"

# ── MFU Central Evaluation Webhook ──────────────────────────────
MFU_CENTRAL_EVAL_WEBHOOK_URL="https://eval-api.mfu.ac.th/v1/ingest"
MFU_CENTRAL_EVAL_API_KEY="mfu-internal-key"

# Exit ticket window (seconds) and auto-enrolment when a student scans the QR
EXIT_TICKET_WINDOW_SEC="180"
AUTO_ENROLL_ON_JOIN="true"

# ── Server ──────────────────────────────────────────────────────
PORT="3000"
HOSTNAME="0.0.0.0"
